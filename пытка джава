const quotes = [
  { text: "Щастя — це не мета, а спосіб життя.", author: "Далай Лама" },
  { text: "Навіть найдовший шлях починається з одного кроку.", author: "Лао-цзи" },
  { text: "Будь тією зміною, яку хочеш бачити у світі.", author: "Махатма Ґанді" },

  { text: "Свідомість не потрібно розширювати, просто перестаньте її обмежувати.", author: "Невідомий" },
  { text: "Ісус Христос — рятівник наркоманів.", author: "Невідомий" },
  { text: "Опівночі всесвіт пахне зірками.", author: "Невідомий" },
  { text: "Не відкладай на завтра те, що давно настав час забути.", author: "Невідомий" },
  { text: "До зірок з безодні.", author: "Невідомий" },
  { text: "Бережи свій внутрішній космос.", author: "Невідомий" }
];

const quoteEl = document.getElementById("quote");
const authorEl = document.getElementById("author");
const button = document.getElementById("newQuote");
const card = document.querySelector(".quote-card");

let currentIndex = -1;

function changeQuote() {
  let newIndex;
  do {
    newIndex = Math.floor(Math.random() * quotes.length);
  } while (newIndex === currentIndex);

  currentIndex = newIndex;

  // робимо картку "матовою" та зникаючою
  card.classList.add("fade");

  setTimeout(() => {
    quoteEl.textContent = quotes[currentIndex].text;
    authorEl.textContent = quotes[currentIndex].author;

    // повертаємо картку
    card.classList.remove("fade");
  }, 400);
}

button.addEventListener("click", changeQuote);

// перша цитата при завантаженні
changeQuote();

/* ===== ФОН З КОМЕТАМИ ===== */
const canvas = document.getElementById("stars");
const ctx = canvas.getContext("2d");

function resize() {
  canvas.width = innerWidth;
  canvas.height = innerHeight;
}
resize();
window.addEventListener("resize", resize);

// МАЛО комет
const comets = Array.from({ length: 12 }, () => ({
  x: Math.random() * innerWidth,
  y: Math.random() * innerHeight - innerHeight,
  speedX: Math.random() * 0.5 + 0.3,
  speedY: Math.random() * 1.5 + 0.8,
  size: Math.random() * 2 + 1,
  tail: Math.random() * 40 + 20,
  opacity: Math.random() * 0.6 + 0.3
}));

function drawComet(c) {
  const angle = Math.atan2(c.speedY, c.speedX);

  const grad = ctx.createLinearGradient(
    c.x,
    c.y,
    c.x - Math.cos(angle) * c.tail,
    c.y - Math.sin(angle) * c.tail
  );

  grad.addColorStop(0, `rgba(255,255,255,${c.opacity})`);
  grad.addColorStop(1, `rgba(255,255,255,0)`);

  ctx.beginPath();
  ctx.moveTo(c.x, c.y);
  ctx.lineTo(
    c.x - Math.cos(angle) * c.tail,
    c.y - Math.sin(angle) * c.tail
  );
  ctx.lineWidth = c.size * 2;
  ctx.strokeStyle = grad;
  ctx.lineCap = "round";
  ctx.stroke();

  ctx.beginPath();
  ctx.arc(c.x, c.y, c.size * 1.5, 0, Math.PI * 2);
  ctx.fillStyle = `rgba(255,255,255,${c.opacity})`;
  ctx.fill();
}

function animate() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  comets.forEach(c => {
    c.x += c.speedX;
    c.y += c.speedY;

    if (c.y > canvas.height + 50) {
      c.y = -50;
      c.x = Math.random() * canvas.width;
    }
    if (c.x > canvas.width + 50) {
      c.x = -50;
    }

    drawComet(c);
  });

  requestAnimationFrame(animate);
}

animate();

window.addEventListener("load", () => {
  document.body.classList.add("loaded");
});
