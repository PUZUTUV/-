* {
  box-sizing: border-box;
  font-family: "Segoe UI", sans-serif;
}

body {
  margin: 0;
  min-height: 100vh;
  background: radial-gradient(circle at top, #fff4b0, #ffd36a);
  overflow: hidden;
}

canvas {
  position: fixed;
  inset: 0;
  z-index: 0;
}

.container {
  position: relative;
  z-index: 1;
  text-align: center;
  padding-top: 80px;
}

/* Початковий стан */
h1 {
  font-size: 48px;
  background: linear-gradient(
    to right,
    #b8860b,
    #a14b0a,
    #f48916,
    #a14b0a,
    #b8860b
  );
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-weight: bold;
}


/* Коли сторінка завантажилась */
body.loaded h1 {
  opacity: 1;
  transform: translateY(0);
}

body.loaded .subtitle {
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0.3s;
}

body.loaded .quote-card {
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0.6s;
}


.subtitle {
  color: #f19d2f;
  margin-bottom: 40px;
}

.quote-card {
  position: relative;
  margin: auto;

  background: rgba(221, 106, 24, 0.15); /* прозора */
  backdrop-filter: blur(12px) saturate(120%);
  -webkit-backdrop-filter: blur(12px) saturate(120%);

  padding: 40px;
  border-radius: 30px;
  width: 70%;
  max-width: 800px;

  box-shadow: 0 20px 40px rgba(0,0,0,0.15);
  border: 1px solid rgba(255,255,255,0.3);

  transition: opacity 0.4s ease,
              transform 0.4s ease,
              backdrop-filter 0.4s ease;
}


.quote-icon {
  position: absolute;
  top: -20px;
  left: 30px;
  background: orange;
  color: white;
  font-size: 30px;
  padding: 15px;
  border-radius: 50%;
}

#quote {
  font-size: 28px;
  font-style: italic;
  color: #343333;
}

.author-line {
  margin: 20px 0 10px auto;
  height: 2px;
  width: 120px;
  background: orange;
}

#author {
  display: block;
  color: #b35c00;
  font-weight: bold;
}

button {
  margin-top: 40px;
  padding: 15px 30px;
  border-radius: 30px;
  border: none;
  background: orange;
  color: white;
  font-size: 18px;
  cursor: pointer;
  box-shadow: 0 10px 20px rgba(0,0,0,0.2);
  transition: 0.2s;
}

button:hover {
  transform: scale(1.05);
}

@keyframes fadeIn {
  from {opacity: 0; transform: translateY(20px);}
  to {opacity: 1; transform: translateY(0);}
}

.quote-card {
  transition: opacity 0.4s ease, transform 0.4s ease, backdrop-filter 0.4s ease;
}

.quote-card.fade {
  opacity: 0;
  transform: scale(0.97);
  backdrop-filter: blur(12px);
}
